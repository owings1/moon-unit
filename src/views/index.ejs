<!DOCTYPE html>
<html>
<head>
    <title>MoonUnit</title>
    <script type="text/javascript" src="static/js/jquery-4.0.0.min.js"></script>
    <script type="text/javascript" src="static/js/controls.js" type="module"></script>
    <link rel="stylesheet" type="text/css" href="static/css/app.css"/>
</head>
<body>
    <div class="content">
        <div class="panel">
            <form>
                <div class="right">
                    <a href="javascript:" class="" id="refresh_status">Refresh</a>
                    <select name="refresh_interval" id="refresh_interval">
                        <option value="0">Never</option>
                        <option value="1">1s</option>
                        <option value="2">2s</option>
                        <option value="5" selected>5s</option>
                        <option value="10">10s</option>
                        <option value="30">30s</option>
                        <option value="60">60s</option>
                    </select>
                </div>
            </form>
            <div class="clear"></div>
        </div>
        <div class="panel status-panel">
            <div class="left">
                <table class="status-table">
                    <thead>
                        <tr>
                            <th colspan="2">Controller State</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>State</td>
                            <td><span id="controller_state"></span></td>
                        </tr>
                    </tbody>
                    <thead>
                        <tr>
                            <th colspan="2">Relative Position</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Scope</td>
                            <td>
                                <span class="position-value" id="position_m1">
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td>Base</td>
                            <td>
                                <span class="position-value" id="position_m2">
                                </span>
                            </td>
                        </tr>
                    </tbody>
                    <thead>
                        <tr>
                            <th colspan="2">Limits Enabled</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Scope</td>
                            <td>
                                <span id="limitsEnabled_m1"></span>
                            </td>
                        </tr>
                        <tr>
                            <td>Base</td>
                            <td><span id="limitsEnabled_m2"></span></td>
                        </tr>
                    </tbody>
                    <thead>
                        <tr>
                            <th colspan="2">Limit Switch States</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Scope CW</td>
                            <td><span id="limitState_m1_cw"></td>
                        </tr>
                        <tr>
                            <td>Scope ACW</td>
                            <td><span id="limitState_m1_acw"></td>
                        </tr>
                        <tr>
                            <td>Base CW</td>
                            <td><span id="limitState_m2_cw"></td>
                        </tr>
                        <tr>
                            <td>Base ACW</td>
                            <td><span id="limitState_m2_acw"></td>
                        </tr>
                    </tbody>
                    <thead>
                        <tr>
                            <th colspan="2">Max Speeds</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Scope</td>
                            <td><span id="maxSpeed_m1"></span></td>
                        </tr>
                        <tr>
                            <td>Base</td>
                            <td><span id="maxSpeed_m2"></span></td>
                        </tr>
                    </tbody>
                    <thead>
                        <tr>
                            <th colspan="2">Accelerations</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Scope</td>
                            <td><span id="acceleration_m1"></span></td>
                        </tr>
                        <tr>
                            <td>Base</td>
                            <td><span id="acceleration_m2"></span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="left">
                <table class="status-table">
                    <thead>
                        <tr>
                            <th colspan="2">Scope Orientation</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>isInit</td>
                            <td><span id="is_orientation_init"></span></td>
                        </tr>
                        <tr>
                            <td>x</td>
                            <td><span id="orientation_x"></span></td>
                        </tr>
                        <tr>
                            <td>y</td>
                            <td><span id="orientation_y"></span></td>
                        </tr>
                        <tr>
                            <td>z</td>
                            <td><span id="orientation_z"></span></td>
                        </tr>
                        <tr>
                            <td>qw</td>
                            <td><span id="orientation_qw"></span></td>
                        </tr>
                        <tr>
                            <td>qx</td>
                            <td><span id="orientation_qx"></span></td>
                        </tr>
                        <tr>
                            <td>qy</td>
                            <td><span id="orientation_qy"></span></td>
                        </tr>
                        <tr>
                            <td>qz</td>
                            <td><span id="orientation_qz"></span></td>
                        </tr>
                        <tr>
                            <td>Temperature</td>
                            <td><span id="temperature"></span></td>
                        </tr>
                        <tr>
                            <td>Calibration</td>
                            <td><span id="orienation_calibration"></span></td>
                        </tr>
                        <tr>
                            <td>isCalibrated</td>
                            <td><span id="is_orientation_calibrated"></span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="left">
                <table class="status-table">
                    <thead>
                        <tr>
                            <th colspan="2">Base Orientation</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>isInit</td>
                            <td><span id="is_base_orientation_init"></span></td>
                        </tr>
                        <tr>
                            <td>x</td>
                            <td><span id="base_orientation_x"></span></td>
                        </tr>
                        <tr>
                            <td>y</td>
                            <td><span id="base_orientation_y"></span></td>
                        </tr>
                        <tr>
                            <td>z</td>
                            <td><span id="base_orientation_z"></span></td>
                        </tr>
                        <tr>
                            <td>qw</td>
                            <td><span id="base_orientation_qw"></span></td>
                        </tr>
                        <tr>
                            <td>qx</td>
                            <td><span id="base_orientation_qx"></span></td>
                        </tr>
                        <tr>
                            <td>qy</td>
                            <td><span id="base_orientation_qy"></span></td>
                        </tr>
                        <tr>
                            <td>qz</td>
                            <td><span id="base_orientation_qz"></span></td>
                        </tr>
                        <tr>
                            <td>Temperature</td>
                            <td><span id="base_temperature"></span></td>
                        </tr>
                        <tr>
                            <td>Calibration</td>
                            <td><span id="base_orienation_calibration"></span></td>
                        </tr>
                        <tr>
                            <td>isCalibrated</td>
                            <td><span id="is_base_orientation_calibrated"></span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="left">
                <table class="status-table">
                    <thead>
                        <tr>
                            <th colspan="2">GPS</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>isInit</td>
                            <td><span id="is_gps_init"></span></td>
                        </tr>
                        <tr>
                            <td>Lat</td>
                            <td><span class="gps-coord" id="gps_lat"></span></td>
                        </tr>
                        <tr>
                            <td>Lon</td>
                            <td><span class="gps-coord" id="gps_long"></span></td>
                        </tr>
                        <tr>
                            <td>Angle</td>
                            <td><span class="gps-coord" id="gps_angle"></span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="left">
                <table class="status-table">
                    <thead>
                        <tr>
                            <th colspan="2">Base Mag</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>isInit</td>
                            <td><span id="is_mag_init"></span></td>
                        </tr>
                        <tr>
                            <td>Heading</td>
                            <td><span class="mag-heading" id="mag_heading"></span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="clear"></div>
        </div>
        <div class="panel">
            <form>
                <div>
                    <a href="javascript:" class="go button red" id="stopsignal">Stop</a>
                </div>
                <table>
                    <tr>
                        <td><a href="javascript:" class="go button blue" id="home_1">Home Scope</a></td>
                        <td><a href="javascript:" class="go button blue" id="end_1">End Scope</a></td>
                    </tr>
                    <tr>
                        <td><a href="javascript:" class="go button blue" id="home_2">Home Base</a></td>
                        <td><a href="javascript:" class="go button blue" id="end_2">End Base</a></td>
                    </tr>
                    <tr>
                        <td><a href="javascript:" class="go button blue" id="home_all">Home All</a></td>
                        <td><a href="javascript:" class="go button blue" id="end_all">End All</a></td>
                    </tr>
                </table>
            </form>
        </div>
        <div class="panel">
            <form>
                <div>
                    <table>
                        <tr>
                            <td>&nbsp;</td>
                            <td><button class="go" id="go_up">&nbsp;up&nbsp;&nbsp;</button></td>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td><button class="go" id="go_left">left</button></td>
                            <td>&nbsp;</td>
                            <td><button class="go" id="go_right">right</button></td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                            <td><button class="go" id="go_down">down</button></td>
                            <td>&nbsp;</td>
                        </tr>
                    </table>
                </div>
                <div>
                    <input type="text" class="howmuch" name="degrees" id="in_howmuch" value="1">
                    <select name="unit" id="in_units">
                        <option value="degrees">degrees</option>
                        <option value="steps">steps</option>
                    </select>
                </div>
            </form>
        </div>
        <div class="panel">
            <form>
                <table>
                    <tr>
                        <td>
                            <select name="dir1" id="in_dir1">
                                <option value="1">up</option>
                                <option value="2">down</option>
                            </select>
                        </td>
                        <td>
                            <input type="text" class="howmuch" name="howmuch1" id="in_howmuch1" value="1">
                        </td>
                        <td rowspan="2">
                            <select name="unit2" id="in_units2">
                                <option value="degrees">degrees</option>
                                <option value="steps">steps</option>
                            </select>
                        </td>
                        <td rowspan="2">
                            <div><button class="go" id="go_both">go</button></div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <select name="dir2" id="in_dir2">
                                <option value="1">right</option>
                                <option value="2">left</option>
                            </select>
                        </td>
                        <td>
                            <input type="text" class="howmuch" name="howmuch2" id="in_howmuch2" value="1">
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td colspan="2">
                            <input type="checkbox" name="isSameTime" id="in_sametime" checked><label for="in_sametime">same time</label>
                        </td>
                        <td></td>
                    </tr>
                </table>
            </form>
        </div>
        <div class="panel">
            <form>
                <div>
                    <input type="text" name="raw" id="in_raw">
                    <button class="go" id="go_raw">Raw</button>
                    <a target="_blank" href="doc/commands">?</a>
                </div>
            </form>
        </div>
        <div class="panel">
            <form>
                <!-- <a href="javascript:" class="gpio button green" id="gpio_controller_state">State</a> -->
                <a href="javascript:" class="button " id="gauger_connected_status">
                    
                </a>
            </form>
        </div>
        <div class="panel">
            <h3>Request</h3>
            <div id="request_output" class="output json"></div>
            <h3>Response</h3>
            <div id="response_output" class="output json"></div>
            <a href="javascript:" class="button gray" id="clear_outputs">Clear</a>
        </div>
    </div>
</body>
</html>
